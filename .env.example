# Persistencia. SQLite funciona sem nenhum servico adicional.
RESUMO_METEO_DATABASE_URL=sqlite:///var/resumo_meteo.sqlite3
RESUMO_METEO_ARTIFACT_ROOT=var/artifacts
RESUMO_METEO_OUTPUT_ROOT=var/outputs
RESUMO_METEO_TIMEZONE=America/Sao_Paulo
RESUMO_METEO_CYCLE=00

# Redacao via API compativel com OpenAI. O exemplo usa um provedor brasileiro;
# troque base URL e modelo conforme o servico escolhido.
WEATHER_SUMMARY_LLM_PROVIDER=maritaca
WEATHER_SUMMARY_LLM_BASE_URL=https://chat.maritaca.ai/api
WEATHER_SUMMARY_LLM_MODEL=sabia-4
WEATHER_SUMMARY_LLM_API_KEY=
WEATHER_SUMMARY_LLM_API_MODE=chat_completions
WEATHER_SUMMARY_LLM_TIMEOUT_SECONDS=180
WEATHER_SUMMARY_LLM_MAX_ATTEMPTS=2
WEATHER_SUMMARY_LLM_MAX_OUTPUT_TOKENS=1200

# IMERG/NASA Earthdata.
NASA_EARTHDATA_TOKEN=

# Ajustes operacionais.
RESUMO_METEO_DOWNLOAD_WORKERS=6
RESUMO_METEO_LOG_LEVEL=INFO
RESUMO_METEO_ANCHOR_HOUR_UTC=0
RESUMO_METEO_MAX_SOURCE_AGE_HOURS=42
RESUMO_METEO_SOURCE_RETENTION_DAYS=3
